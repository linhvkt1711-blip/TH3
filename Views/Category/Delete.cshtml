@model TH3.Models.Category

@{
    ViewData["Title"] = "Xác nhận xóa danh mục";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>XÁC NHẬN XÓA</h5>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="fs-5">Bạn có chắc chắn muốn xóa danh mục này không?</p>
                    <h3 class="text-danger fw-bold mb-4">"@Model.Name"</h3>

                    <div class="alert alert-warning small">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Lưu ý: Việc xóa danh mục có thể ảnh hưởng đến các sản phẩm đang thuộc danh mục này.
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-center gap-2 mt-4">
                            <button type="submit" class="btn btn-danger px-5 fw-bold">Xác nhận xóa</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>