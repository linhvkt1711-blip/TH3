@model TH3.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    bool isAdmin = User.IsInRole("Admin");

    // Định nghĩa màu sắc trạng thái
    var statusClass = Model.OrderStatus switch
    {
        "PENDING_APPROVAL" => "warning",
        "APPROVED" => "success",
        "REJECTED" => "danger",
        "CANCELLED" => "secondary",
        _ => "info"
    };

    var statusText = Model.OrderStatus switch
    {
        "PENDING_APPROVAL" => "Chờ duyệt",
        "APPROVED" => "Đã duyệt",
        "REJECTED" => "Từ chối",
        "CANCELLED" => "Đã hủy",
        _ => Model.OrderStatus
    };
}

<style>
    body {
        background-color: #f8f9fa;
    }

    .order-header {
        background: white;
        padding: 20px;
        border-bottom: 1px solid #dee2e6;
        margin-bottom: 25px;
    }

    .card-info {
        border: none;
        border-radius: 10px;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        height: 100%;
    }

    .info-label {
        color: #6c757d;
        font-size: 0.8rem;
        text-transform: uppercase;
        font-weight: 700;
        display: block;
        margin-bottom: 5px;
    }

    .product-img {
        width: 70px;
        height: 70px;
        object-fit: contain;
        border-radius: 8px;
        border: 1px solid #eee;
        background: #fff;
    }

    .table thead th {
        border-top: none;
        background-color: #fcfcfc;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
    }
</style>

<div class="order-header shadow-sm">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-1">Đơn hàng #@Model.Id</h3>
            <p class="text-muted mb-0"><i class="far fa-calendar-alt me-1"></i> Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</p>
        </div>
        <a asp-action="Index" asp-controller="@(isAdmin ? "OrderManager" : "Order")" class="btn btn-outline-dark rounded-pill px-4">
            <i class="fas fa-arrow-left me-2"></i> Quay lại danh sách
        </a>
    </div>
</div>

<div class="container">
    @* Thông tin tổng quan *@
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card card-info p-3">
                <span class="info-label">Trạng thái</span>
                <span class="badge bg-@statusClass fs-6 w-fit">@statusText</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-info p-3 text-danger">
                <span class="info-label">Tổng thanh toán</span>
                <div class="fs-4 fw-bold">@Model.TotalPrice.ToString("N0") đ</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-info p-3">
                <span class="info-label">Khách hàng</span>
                <div class="fw-bold">@(Model.ApplicationUser?.UserName ?? "Khách vãng lai")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-info p-3">
                <span class="info-label">Thanh toán</span>
                <div class="fw-bold">@Model.PaymentMethod</div>
            </div>
        </div>
    </div>

    @* Địa chỉ *@
    <div class="card card-info p-3 mb-4">
        <span class="info-label">Địa chỉ giao hàng</span>
        <div class="fw-bold"><i class="fas fa-map-marker-alt text-danger me-2"></i>@Model.ShippingAddress</div>
    </div>

    @* Danh sách sản phẩm *@
    <div class="card card-info overflow-hidden mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">Sản phẩm đã đặt</h5>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Sản phẩm</th>
                        <th>Tên</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end pe-4">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderDetails)
                    {
                        // ƯU TIÊN LẤY ẢNH CHÍNH (THUMBNAIL) TRƯỚC
                        var imgUrl = item.Product?.ImageUrl ?? item.Product?.ProductImages?.FirstOrDefault()?.Url;
                        if (string.IsNullOrEmpty(imgUrl)) { imgUrl = "/images/no-image.png"; }

                        var thanhTien = item.Price * item.Quantity;
                        <tr>
                            <td class="ps-4">
                                <img src="@imgUrl" class="product-img shadow-sm" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.Product?.Name</div>
                                <small class="text-muted">Mã SP: @item.ProductId</small>
                            </td>
                            <td class="text-center">x(@item.Quantity)</td>
                            <td class="text-end">@item.Price.ToString("N0") đ</td>
                            <td class="text-end pe-4 fw-bold">@thanhTien.ToString("N0") đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Ghi chú và Hành động *@
    <div class="card card-info p-3 mb-5 d-flex flex-row justify-content-between align-items-center">
        <div>
            <span class="info-label">Ghi chú đơn hàng</span>
            <div class="text-muted">@(string.IsNullOrEmpty(Model.Notes) ? "Không có ghi chú nào" : Model.Notes)</div>
        </div>

        <div>
            @if (Model.OrderStatus == "PENDING_APPROVAL")
            {
                if (isAdmin)
                {
                    <div class="d-flex gap-2">
                        <form asp-action="Approve" asp-controller="OrderManager" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">Duyệt đơn</button>
                        </form>
                        <button type="button" class="btn btn-outline-danger rounded-pill px-4 fw-bold"
                                onclick="confirm('Bạn có chắc chắn muốn từ chối đơn hàng này?') ? document.getElementById('reject-order-form').submit() : null;">
                            Từ chối
                        </button>
                    </div>
                }
                else
                {
                    <form asp-action="Cancel" asp-controller="Order" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn hàng này?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">Hủy đơn hàng</button>
                    </form>
                }
            }
        </div>
    </div>

    @if (isAdmin)
    {
        <form asp-action="Reject" asp-controller="OrderManager" method="post" id="reject-order-form" style="display:none;">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="rejectionReason" value="Hủy bởi Admin" />
        </form>
    }
</div>