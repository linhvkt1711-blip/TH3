@model TH3.Models.Order

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Chi tiết đơn hàng</h2>
        <a asp-action="Index" asp-controller="@(User.IsInRole("Admin") ? "OrderManager" : "Order")" class="btn btn-outline-secondary">
            ← Quay lại lịch sử
        </a>
    </div>

    @* --- Khu vực thông tin đơn hàng --- *@
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card p-3 shadow-sm border-0">
                <strong>Mã đơn:</strong>
                <div class="fs-4">#@Model.Id</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm border-0">
                <strong>Ngày đặt:</strong>
                <div>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm border-0">
                <strong>Trạng thái:</strong>
                <div>
                    @switch (Model.OrderStatus)
                    {
                        case "PENDING_APPROVAL":
                            <span class="badge bg-warning text-dark">Chờ duyệt</span>
                            ; break;
                        case "APPROVED":
                            <span class="badge bg-success">Đã duyệt</span>
                            ; break;
                        case "REJECTED":
                            <span class="badge bg-danger">Đã từ chối</span>
                            ; break;
                        case "CANCELLED":
                            <span class="badge bg-secondary">Đã hủy</span>
                            ; break;
                        default:
                            <span class="badge bg-info">@Model.OrderStatus</span>
                            ; break;
                    }
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm border-0">
                <strong>Tổng tiền:</strong>
                <div class="text-danger fs-5 fw-bold">@Model.TotalPrice.ToString("N0") đ</div>
            </div>
        </div>
    </div>

    @* --- Khu vực thông tin khách hàng --- *@
    <div class="row mb-4 g-3">
        <div class="col-md-4">
            <div class="card p-3 border-0 shadow-sm">
                <strong>Khách:</strong>
                <div>@(Model.ApplicationUser?.UserName ?? User.Identity.Name ?? "Khách vãng lai")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 border-0 shadow-sm">
                <strong>Phương thức thanh toán:</strong>
                <div>@Model.PaymentMethod</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 border-0 shadow-sm">
                <strong>Địa chỉ giao hàng:</strong>
                <div>@Model.ShippingAddress</div>
            </div>
        </div>
    </div>

    <h3>Sản phẩm</h3>
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-bordered align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 100px;">Ảnh</th>
                    <th>Tên</th>
                    <th class="text-center">SL</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    // FIX Ở ĐÂY: Ưu tiên lấy ImageUrl (Ảnh chính/Thumbnail) trước
                    var img = item.Product?.ImageUrl;

                    // Nếu ImageUrl trống thì mới lấy ảnh đầu tiên trong danh sách ảnh phụ
                    if (string.IsNullOrEmpty(img))
                    {
                        img = item.Product?.ProductImages?.FirstOrDefault()?.Url;
                    }

                    // Nếu vẫn trống thì dùng ảnh mặc định
                    if (string.IsNullOrEmpty(img)) { img = "/images/no-image.png"; }

                    var thanhTien = item.Price * item.Quantity;

                    <tr>
                        <td class="text-center">
                            <img src="@img" class="img-fluid rounded border" style="width: 70px; height:70px; object-fit:contain; background:#fff;" />
                        </td>
                        <td class="fw-bold">@item.Product?.Name</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">@item.Price.ToString("N0") đ</td>
                        <td class="text-end fw-bold text-primary">@thanhTien.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4 p-3 bg-white border rounded shadow-sm">
        <span class="text-muted"><strong>Ghi chú:</strong> @(string.IsNullOrEmpty(Model.Notes) ? "Không có" : Model.Notes)</span>

        @if (Model.OrderStatus == "PENDING_APPROVAL")
        {
            if (User.IsInRole("Admin"))
            {
                <div class="btn-group" role="group">
                    <form asp-action="Approve" asp-controller="OrderManager" method="post" class="d-inline me-2">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">Duyệt đơn</button>
                    </form>
                    <button type="button" class="btn btn-outline-danger px-4 fw-bold" onclick="confirm('Bạn có chắc chắn muốn từ chối đơn hàng này?') ? document.getElementById('reject-order-form').submit() : null;">Từ chối</button>
                </div>
            }
            else
            {
                <form asp-action="Cancel" asp-controller="Order" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn hàng này?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">Hủy đơn hàng</button>
                </form>
            }
        }
    </div>

    @if (User.IsInRole("Admin"))
    {
        <form asp-action="Reject" asp-controller="OrderManager" method="post" id="reject-order-form" style="display:none;">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="rejectionReason" value="Hủy bởi Admin" />
        </form>
    }
</div>