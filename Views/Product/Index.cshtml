@model IEnumerable<TH3.Models.Product>

@{
    ViewData["Title"] = "Cửa hàng Công nghệ";
}

<style>
    /* Custom CSS phong cách CellphoneS */
    .product-card {
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            border-color: #d70018;
        }

    .product-img-container {
        position: relative;
        padding-top: 100%; /* Tạo khung vuông 1:1 */
        background: #f8f9fa;
        overflow: hidden;
    }

        .product-img-container img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: contain; /* Giữ nguyên tỉ lệ ảnh không bị méo */
            padding: 10px;
        }

    .product-info {
        padding: 15px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .product-name {
        font-size: 16px;
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
        height: 44px; /* Giới hạn 2 dòng tiêu đề */
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-decoration: none;
    }

        .product-name:hover {
            color: #d70018;
        }

    .product-price {
        color: #d70018;
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .category-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        background: rgba(215, 0, 24, 0.8);
        color: white;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 12px;
        z-index: 1;
    }

    .btn-buy {
        background-color: #d70018;
        color: white;
        border: none;
        border-radius: 5px;
        padding: 8px;
        font-weight: 600;
        width: 100%;
        transition: 0.3s;
    }

        .btn-buy:hover {
            background-color: #a50012;
            color: white;
        }

    .action-links {
        margin-top: 10px;
        font-size: 13px;
        text-align: center;
        border-top: 1px solid #eee;
        padding-top: 10px;
    }

    .filter-section {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .filter-form {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        align-items: flex-end;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
    }

    .filter-group label {
        font-weight: 600;
        margin-bottom: 5px;
        font-size: 14px;
        color: #333;
    }

    .filter-group input {
        padding: 8px 12px;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 14px;
    }

    .filter-group button {
        background-color: #d70018;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 5px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
    }

    .filter-group button:hover {
        background-color: #a50012;
    }

    .reset-filter {
        background-color: #6c757d !important;
    }

    .reset-filter:hover {
        background-color: #5a6268 !important;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">DANH SÁCH SẢN PHẨM</h2>
        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <a asp-action="Add" class="btn btn-success rounded-pill shadow-sm">
                <i class="fas fa-plus"></i> Thêm sản phẩm mới
            </a>
        }
    </div>

    <!-- Price Filter Section -->
    <div class="filter-section">
        <h5 class="mb-3">Lọc theo giá</h5>
        <form asp-action="Index" method="get" class="filter-form">
            <div class="filter-group">
                <label for="minPrice">Giá tối thiểu (₫)</label>
                <input type="number" id="minPrice" name="minPrice" placeholder="0" min="0" step="1000" value="@(ViewBag.MinPrice ?? "")" />
            </div>
            <div class="filter-group">
                <label for="maxPrice">Giá tối đa (₫)</label>
                <input type="number" id="maxPrice" name="maxPrice" placeholder="999999999" min="0" step="1000" value="@(ViewBag.MaxPrice ?? "")" />
            </div>
            <div class="filter-group">
                <label for="searchString">Tìm kiếm</label>
                <input type="text" id="searchString" name="searchString" placeholder="Tên sản phẩm..." value="@(ViewBag.SearchString ?? "")" />
            </div>
            <div class="filter-group">
                <button type="submit">Lọc</button>
            </div>
            <div class="filter-group">
                <button type="button" class="reset-filter" onclick="window.location.href='@Url.Action("Index", "Product")'; ">Xóa lọc</button>
            </div>
        </form>
    </div>

    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="product-card">
                    <div class="product-img-container">
                        @if (product.Category != null)
                        {
                            <span class="category-badge">@product.Category.Name</span>
                        }

                        <a asp-action="Display" asp-route-id="@product.Id">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" />
                            }
                            else
                            {
                                <img src="/images/no-image.png" alt="No Image" />
                            }
                        </a>
                    </div>

                    <div class="product-info">
                        <a asp-action="Display" asp-route-id="@product.Id" class="product-name">
                            @product.Name
                        </a>
                        <div class="product-price">
                            @product.Price.ToString("N0")₫
                        </div>

                        <button type="button" 
                                class="btn-buy mt-auto btn-add-cart"
                                data-product-id="@product.Id"
                                data-quantity="1">
                            MUA NGAY
                        </button>
                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <div class="action-links">
                                <a asp-action="Update" asp-route-id="@product.Id" class="text-primary me-2 text-decoration-none">Sửa</a>
                            <span class="text-muted">|</span>
                            <a asp-action="Delete" asp-route-id="@product.Id" class="text-danger ms-2 text-decoration-none">Xóa</a>
                        </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    // Handle Add to Cart button clicks with AJAX
    document.querySelectorAll('.btn-add-cart').forEach(button => {
        button.addEventListener('click', async function(e) {
            e.preventDefault();
            
            const productId = this.getAttribute('data-product-id');
            const quantity = this.getAttribute('data-quantity');
            const btn = this;
            
            // Disable button during request
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = 'Đang thêm...';
            
            try {
                const response = await fetch(`/ShoppingCart/AddToCart?productId=${productId}&quantity=${quantity}`, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                
                if (response.ok) {
                    const data = await response.json();
                    
                    // Update cart count badge in header
                    const cartCountBadge = document.getElementById('cart-count');
                    if (cartCountBadge && data.cartCount !== undefined) {
                        cartCountBadge.textContent = data.cartCount;
                    }
                    
                    // Show success alert
                    alert(data.message);
                } else {
                    alert('Có lỗi xảy ra. Vui lòng thử lại.');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Có lỗi xảy ra. Vui lòng thử lại.');
            } finally {
                // Re-enable button
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        });
    });
</script>