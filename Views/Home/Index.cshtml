@using TH3.Services

@model IEnumerable<TH3.Models.Product>

@{
    ViewData["Title"] = "ACE - Cửa hàng Công nghệ";

    int numOfQuantity = 1;

    var recommendations =
        ViewBag.Recommendations
        as List<TH3.Services.RecommendationResult>;
}

<style>

    .cate-item {
        background: white;
        border-radius: 12px;
        padding: 15px;
        text-align: center;
        transition: 0.3s;
        text-decoration: none;
        color: #333;
        display: block;
        border: 1px solid #eee;
    }

    .cate-item:hover {
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        transform: translateY(-5px);
        color: #0d6efd;
        border-color: #0d6efd;
    }

    .cate-item i {
        font-size: 30px;
        margin-bottom: 10px;
        display: block;
        color: #0d6efd;
    }

    .product-card {
        background: white;
        border-radius: 15px;
        padding: 15px;
        transition: 0.3s;
        height: 100%;
        border: none;
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .product-card:hover {
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        transform: translateY(-3px);
    }

    .product-card img {
        width: 100%;
        height: 180px;
        object-fit: contain;
    }

    .product-price {
        color: #0d6efd;
        font-weight: bold;
        font-size: 18px;
        margin-bottom: 5px;
    }

    .product-name {
        font-size: 14px;
        font-weight: 600;
        height: 40px;
        overflow: hidden;
        margin: 10px 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        color: #333;
    }

    .discount-tag {
        position: absolute;
        top: 10px;
        left: 10px;
        background: #0d6efd;
        color: white;
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 11px;
        z-index: 10;
    }

    .filter-card {
        background: #ffffff;
        transition: all 0.3s ease;
    }

</style>

<!-- DANH MỤC -->

<div class="row g-4 mb-5 text-center justify-content-center row-cols-2 row-cols-md-6">

    <div class="col">

        <a asp-action="Index"
           asp-route-searchString="Điện thoại"
           class="cate-item shadow-sm">

            <i class="fa-solid fa-mobile-screen"></i>

            <span>Điện thoại</span>
            <span class="badge bg-dark text-white rounded-pill small mt-1">IP / SS</span>

        </a>

    </div>

    <div class="col">

        <a asp-action="Index"
           asp-route-searchString="Ốp"
           class="cate-item shadow-sm border-warning border-2 bg-warning bg-opacity-10">

            <i class="fa-solid fa-cube text-warning fs-2"></i>

            <span class="fw-bold text-dark d-block">Ốp lưng 3D</span>
            <span class="badge bg-warning text-dark border border-dark rounded-pill small mt-1">Mã: OL</span>

        </a>

    </div>

    <div class="col">

        <a asp-action="Index"
           asp-route-searchString="Laptop"
           class="cate-item shadow-sm">

            <i class="fa-solid fa-laptop"></i>

            <span>Laptop</span>
            <span class="badge bg-secondary rounded-pill small mt-1">Mã: LT</span>

        </a>

    </div>

    <div class="col">

        <a asp-action="Index"
           asp-route-searchString="Máy tính bảng"
           class="cate-item shadow-sm">

            <i class="fa-solid fa-tablet-screen-button"></i>

            <span>Tablet</span>
            <span class="badge bg-secondary rounded-pill small mt-1">Mã: TB</span>

        </a>

    </div>

    <div class="col">

        <a asp-action="Index"
           asp-route-searchString="Âm thanh"
           class="cate-item shadow-sm">

            <i class="fa-solid fa-headphones"></i>

            <span>Tai nghe</span>
            <span class="badge bg-secondary rounded-pill small mt-1">Mã: TN</span>

        </a>

    </div>

    <div class="col">

        <a asp-action="Index"
           asp-route-searchString="Đồng hồ"
           class="cate-item shadow-sm">

            <i class="fa-solid fa-clock"></i>

            <span>Đồng hồ</span>
            <span class="badge bg-secondary rounded-pill small mt-1">Mã: DH</span>

        </a>

    </div>

</div>

<!-- FILTER -->

<div class="filter-card shadow-sm border-0 rounded-4 p-4 mb-5">

    <form asp-action="Index" method="get" class="row g-3">

        <input type="hidden"
               name="searchString"
               value="@Context.Request.Query["searchString"]" />

        <div class="col-md-4">

            <input type="number"
                   class="form-control"
                   name="minPrice"
                   placeholder="Giá tối thiểu"
                   value="@Context.Request.Query["minPrice"]" />

        </div>

        <div class="col-md-4">

            <input type="number"
                   class="form-control"
                   name="maxPrice"
                   placeholder="Giá tối đa"
                   value="@Context.Request.Query["maxPrice"]" />

        </div>

        <div class="col-md-4">

            <button type="submit"
                    class="btn btn-danger w-100">

                Áp dụng

            </button>

        </div>

    </form>

</div>

<!-- AI RECOMMENDATION -->

@if (recommendations != null && recommendations.Any())
{
    <div class="mb-5">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h3 class="fw-bold m-0"
                style="border-left: 5px solid #0d6efd; padding-left: 15px;">

                Gợi Ý Sản Phẩm

            </h3>

        </div>

        <div class="row g-3">

            @foreach (var item in recommendations)
            {
                <div class="col-6 col-md-4 col-lg-3">

                    <div class="product-card shadow-sm text-center">

                        <div class="discount-tag bg-primary">

                            Đề Xuất

                        </div>

                        <a asp-controller="Product"
                           asp-action="Display"
                           asp-route-id="@item.ProductId">

                            <img src="@item.ImageUrl"
                                 alt="@item.Name" />

                        </a>

                        <a asp-controller="Product"
                           asp-action="Display"
                           asp-route-id="@item.ProductId"
                           class="text-decoration-none">

                            <p class="product-name">

                                @item.Name

                            </p>

                        </a>

                        <p class="product-price">

                            @item.Price.ToString("N0")₫

                        </p>

                        <div class="text-primary small mb-2 fw-bold">
                           

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>
}

<!-- BANNER PHÒNG THỬ ỐP LƯNG 3D & AI NHẬN DIỆN THIẾT BỊ -->
<div class="card border-0 rounded-4 text-white p-4 mb-5 shadow" 
     style="background: linear-gradient(135deg, #18191d 0%, #2b2e38 60%, #1e222d 100%); border-left: 6px solid #ffc107 !important;">
    <div class="row align-items-center">
        <div class="col-md-8">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-warning text-dark fw-bold px-3 py-1"><i class="fa fa-cube me-1"></i> 3D TRY-ON STUDIO</span>
                <span class="badge bg-info text-dark fw-bold px-2 py-1"><i class="fa fa-robot me-1"></i> YOLO AI POWERED</span>
            </div>
            <h3 class="fw-bold text-white mb-2">Phòng Thử Ốp Lưng 3D & AI Nhận Diện Thiết Bị</h3>
            <p class="text-white-50 m-0">
                Chụp ảnh mặt lưng điện thoại &rarr; AI YOLO tự động định danh dòng máy &rarr; Thử ốp lưng 3D 360&deg;, tách ốp, khắc tên Laser thời gian thực.
            </p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a href="/TryOn3D/Studio" class="btn btn-warning btn-lg fw-bold px-4 py-3 text-dark shadow-sm text-decoration-none">
                <i class="fa fa-cube me-2"></i>Vào Phòng Thử 3D
            </a>
        </div>
    </div>
</div>

<!-- SẢN PHẨM -->

<div class="d-flex justify-content-between align-items-center mb-4">

    <h3 class="fw-bold m-0"
        style="border-left: 5px solid #d70018; padding-left: 15px;">

        SẢN PHẨM NỔI BẬT

    </h3>

</div>

<div class="row g-3 mb-5">

    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="col-6 col-md-4 col-lg-3">

                <div class="product-card shadow-sm text-center">

                    <div class="discount-tag">
                        Trả góp 0%
                    </div>

                    <!-- BADGE PHÂN LOẠI MÃ SẢN PHẨM: IP01, SS01, OL01, TN01... -->
                    <div class="position-absolute" style="top: 10px; right: 10px; z-index: 10;">
                        <span class="badge @(item.ProductCode.StartsWith("OL") ? "bg-warning text-dark border border-dark fw-bold" : (item.ProductCode.StartsWith("IP") ? "bg-dark text-white fw-bold" : "bg-primary text-white fw-bold")) shadow-sm px-2 py-1">
                            @item.ProductCode
                        </span>
                    </div>

                    <a asp-controller="Product"
                       asp-action="Display"
                       asp-route-id="@item.Id">

                        <img src="@item.ImageUrl"
                             alt="@item.Name" />

                    </a>

                    <a asp-controller="Product"
                       asp-action="Display"
                       asp-route-id="@item.Id"
                       class="text-decoration-none">

                        <p class="product-name">
                            @item.Name
                        </p>

                    </a>

                    <!-- Dòng thông tin phân loại mã và thiết bị tương thích -->
                    <div class="d-flex justify-content-center gap-1 mb-2">
                        <span class="badge bg-light text-secondary border">Mã: @item.ProductCode</span>
                        @if (!string.IsNullOrEmpty(item.CompatibleDeviceCode))
                        {
                            <span class="badge bg-warning bg-opacity-25 text-dark border border-warning">Khớp: @item.CompatibleDeviceCode</span>
                        }
                    </div>

                    <p class="product-price">
                        @item.Price.ToString("N0")₫
                    </p>

                    @if (item.ProductCode.StartsWith("OL") || item.Name.Contains("Ốp"))
                    {
                        <a href="/TryOn3D/Studio?productId=@item.Id" class="btn btn-warning btn-sm fw-bold w-100 mb-2 text-dark shadow-sm">
                            <i class="fa fa-cube me-1"></i> Thử ốp 3D
                        </a>
                    }

                    <div class="text-muted small mb-3">
                        <i class="fa fa-star text-warning"></i>
                        5/5 (100 đánh giá)
                    </div>

                    <div class="mt-auto d-flex justify-content-center gap-2">

                        <button type="button"
                                class="btn btn-outline-dark btn-sm btn-add-to-cart"
                                data-product-id="@item.Id"
                                data-quantity="@numOfQuantity">

                            <i class="bi-cart-fill"></i>

                            Thêm vào giỏ

                        </button>

                        <a asp-controller="ShoppingCart"
                           asp-action="BuyNow"
                           asp-route-productId="@item.Id"
                           asp-route-quantity="@numOfQuantity"
                           class="btn btn-danger btn-sm">

                            Mua Ngay

                        </a>

                    </div>

                </div>

            </div>
        }
    }

</div>

<script>

    document
        .querySelectorAll('.btn-add-to-cart')
        .forEach(button => {

            button.addEventListener('click', async function (e) {

                e.preventDefault();

                const productId =
                    this.getAttribute('data-product-id');

                const quantity =
                    this.getAttribute('data-quantity');

                try {

                    const response =
                        await fetch(
                            `/ShoppingCart/AddToCart?productId=${productId}&quantity=${quantity}`
                        );

                    if (response.ok) {

                        alert('Đã thêm vào giỏ hàng');

                    }

                }
                catch (error) {

                    console.log(error);

                }

            });

        });

</script>