@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card border-0 shadow-lg overflow-hidden" style="border-radius: 15px;">
                <div class="row g-0">
                    <div class="col-md-6 p-4 p-md-5">
                        <div class="text-center mb-4">
                            <h3 class="fw-bold text-primary">Chào mừng trở lại!</h3>
                            <p class="text-muted small">Vui lòng đăng nhập vào tài khoản của bạn</p>
                        </div>

                        <form id="account" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                <label asp-for="Input.Email">Email của bạn</label>
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                                <label asp-for="Input.Password">Mật khẩu</label>
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="Input.RememberMe" />
                                    <label class="form-check-label small" asp-for="Input.RememberMe">
                                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                                    </label>
                                </div>
                                <a id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none">Quên mật khẩu?</a>
                            </div>

                            <button id="login-submit" type="submit" class="w-100 btn btn-primary btn-lg mb-3 shadow-sm" style="border-radius: 10px;">
                                Đăng nhập
                            </button>

                            <div class="text-center mt-3">
                                <p class="small mb-0">
                                    Chưa có tài khoản?
                                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-decoration-none">Đăng ký ngay</a>
                                </p>
                                <p class="mt-2">
                                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-muted small text-decoration-none">Gửi lại email xác nhận</a>
                                </p>
                            </div>
                        </form>
                    </div>

                    <div class="col-md-6 bg-light d-flex align-items-center p-4 p-md-5 border-start">
                        <div class="w-100">
                            <hr />
                            @{
                                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                                {
                                    <div class="text-center py-4">
                                        <div class="mb-3">
                                            <i class="bi bi-shield-lock" style="font-size: 3rem; color: #dee2e6;"></i>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                        <div class="d-grid gap-2">
                                            @foreach (var provider in Model.ExternalLogins!)
                                            {
                                                <button type="submit" class="btn btn-outline-dark d-flex align-items-center justify-content-center" name="provider" value="@provider.Name">
                                                    @if (provider.DisplayName == "Google")
                                                    {
                                                        <i class="bi bi-google me-2 text-danger"></i>
                                                    }
                                                    @if (provider.DisplayName == "Facebook")
                                                    {
                                                        <i class="bi bi-facebook me-2 text-primary"></i>
                                                    }
                                                    Tiếp tục với @provider.DisplayName
                                                </button>
                                            }
                                        </div>
                                    </form>
                                }
                            }

                            <div class="mt-5 text-center d-none d-md-block">
                                <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-login-form/draw2.svg" class="img-fluid" alt="Illustration">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}