@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dữ liệu cá nhân";
    ViewData["ActivePage"] = "PersonalData";
}

<h3 class="fw-bold text-dark mb-4 border-bottom pb-2">
    <i class="fa-solid fa-database text-danger me-2"></i>Dữ liệu cá nhân
</h3>

<div class="row animate-fade-in">
    <div class="col-lg-10">
        <div class="card bg-light border-0 rounded-3 p-4 mb-4">
            <p class="mb-0 text-muted small lh-lg">
                Tài khoản của bạn chứa dữ liệu cá nhân do chính bạn cung cấp. Trang này cho phép bạn tải xuống hoặc xóa vĩnh viễn các dữ liệu đó.
            </p>
            <div class="alert alert-warning border-0 rounded-3 shadow-sm d-flex align-items-center gap-2 mt-3 mb-0">
                <i class="fa-solid fa-triangle-exclamation fs-5"></i>
                <div class="small fw-semibold">Việc xóa dữ liệu này sẽ xóa vĩnh viễn tài khoản của bạn và không thể phục hồi lại.</div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <form id="download-data" asp-page="DownloadPersonalData" method="post" class="form-group mb-0">
                <button class="btn btn-danger btn-sm rounded-3 px-4 py-2 fw-semibold" type="submit" style="background: linear-gradient(135deg, #d70018 0%, #af0013 100%); border: none;">
                    <i class="fa-solid fa-download me-1"></i> Tải về dữ liệu
                </button>
            </form>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-outline-danger btn-sm rounded-3 px-4 py-2 fw-semibold">
                <i class="fa-solid fa-trash-can me-1"></i> Xóa tài khoản của tôi
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
