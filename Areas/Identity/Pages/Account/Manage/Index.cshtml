@page
@model IndexModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["ActivePage"] = "Profile";
}

<h3 class="fw-bold text-dark mb-4 border-bottom pb-2">
    <i class="fa-solid fa-id-card text-danger me-2"></i>Thông tin cá nhân
</h3>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    var isError = Model.StatusMessage.StartsWith("Lỗi", StringComparison.OrdinalIgnoreCase) || Model.StatusMessage.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
    var statusMessageClass = isError ? "danger" : "success";
    var iconClass = isError ? "fa-circle-xmark" : "fa-circle-check";
    <div class="alert alert-@statusMessageClass alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid @iconClass fs-5"></i>
        <div>@Model.StatusMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form id="profile-form" method="post" class="needs-validation">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-4" role="alert"></div>

    <div class="row g-4">
        <!-- Tên đăng nhập (Email) -->
        <div class="col-md-6">
            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control bg-light text-muted border-0 shadow-none" placeholder="Username" disabled style="cursor: not-allowed; font-weight: 500;" />
                <label asp-for="Username" class="text-muted"><i class="fa-solid fa-lock me-2"></i>Tên đăng nhập (Email)</label>
            </div>
        </div>

        <!-- Họ và tên -->
        <div class="col-md-6">
            <div class="form-floating mb-3">
                <input asp-for="Input.FullName" class="form-control rounded-3 border" placeholder="Họ và tên" required />
                <label asp-for="Input.FullName"><i class="fa-solid fa-user me-2 text-danger"></i>Họ và tên</label>
                <span asp-validation-for="Input.FullName" class="text-danger small"></span>
            </div>
        </div>

        <!-- Số điện thoại -->
        <div class="col-md-6">
            <div class="form-floating mb-3">
                <input asp-for="Input.PhoneNumber" class="form-control rounded-3 border" placeholder="Số điện thoại" />
                <label asp-for="Input.PhoneNumber"><i class="fa-solid fa-phone me-2 text-danger"></i>Số điện thoại</label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
            </div>
        </div>

        <!-- Tuổi -->
        <div class="col-md-6">
            <div class="form-floating mb-3">
                <input asp-for="Input.Age" class="form-control rounded-3 border" placeholder="Tuổi" type="number" min="0" max="120" />
                <label asp-for="Input.Age"><i class="fa-solid fa-cake-candles me-2 text-danger"></i>Tuổi</label>
                <span asp-validation-for="Input.Age" class="text-danger small"></span>
            </div>
        </div>

        <!-- Địa chỉ -->
        <div class="col-12">
            <div class="form-floating mb-4">
                <input asp-for="Input.Address" class="form-control rounded-3 border" placeholder="Địa chỉ" />
                <label asp-for="Input.Address"><i class="fa-solid fa-location-dot me-2 text-danger"></i>Địa chỉ liên hệ</label>
                <span asp-validation-for="Input.Address" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-start mt-2">
        <button id="update-profile-button" type="submit" class="btn-save-settings d-flex align-items-center gap-2">
            <i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
