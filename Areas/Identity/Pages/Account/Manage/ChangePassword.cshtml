@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["ActivePage"] = "ChangePassword";
}

<h3 class="fw-bold text-dark mb-4 border-bottom pb-2">
    <i class="fa-solid fa-key text-danger me-2"></i>Đổi mật khẩu
</h3>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    var isError = Model.StatusMessage.StartsWith("Lỗi", StringComparison.OrdinalIgnoreCase) || Model.StatusMessage.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
    var statusMessageClass = isError ? "danger" : "success";
    var iconClass = isError ? "fa-circle-xmark" : "fa-circle-check";
    <div class="alert alert-@statusMessageClass alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid @iconClass fs-5"></i>
        <div>@Model.StatusMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row animate-fade-in">
    <div class="col-lg-8">
        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

            <!-- Mật khẩu hiện tại -->
            <div class="form-floating mb-3">
                <input asp-for="Input.OldPassword" class="form-control rounded-3 border" autocomplete="current-password" aria-required="true" placeholder="Mật khẩu hiện tại" />
                <label asp-for="Input.OldPassword"><i class="fa-solid fa-lock me-2 text-danger"></i>Mật khẩu hiện tại</label>
                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
            </div>

            <!-- Mật khẩu mới -->
            <div class="form-floating mb-3">
                <input asp-for="Input.NewPassword" class="form-control rounded-3 border" autocomplete="new-password" aria-required="true" placeholder="Mật khẩu mới" />
                <label asp-for="Input.NewPassword"><i class="fa-solid fa-key me-2 text-danger"></i>Mật khẩu mới</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>

            <!-- Xác nhận mật khẩu mới -->
            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control rounded-3 border" autocomplete="new-password" aria-required="true" placeholder="Xác nhận mật khẩu mới" />
                <label asp-for="Input.ConfirmPassword"><i class="fa-solid fa-circle-check me-2 text-danger"></i>Xác nhận mật khẩu mới</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-save-settings d-flex align-items-center gap-2">
                <i class="fa-solid fa-check-double"></i> Cập nhật mật khẩu
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
