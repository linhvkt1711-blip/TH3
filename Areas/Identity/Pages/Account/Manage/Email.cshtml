@page
@model EmailModel
@{
    ViewData["Title"] = "Địa chỉ Email";
    ViewData["ActivePage"] = "Email";
}

<h3 class="fw-bold text-dark mb-4 border-bottom pb-2">
    <i class="fa-solid fa-envelope text-danger me-2"></i>Cài đặt Email
</h3>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    var isError = Model.StatusMessage.StartsWith("Lỗi", StringComparison.OrdinalIgnoreCase) || Model.StatusMessage.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
    var statusMessageClass = isError ? "danger" : "success";
    var iconClass = isError ? "fa-circle-xmark" : "fa-circle-check";
    <div class="alert alert-@statusMessageClass alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid @iconClass fs-5"></i>
        <div>@Model.StatusMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row animate-fade-in">
    <div class="col-lg-8">
        <form id="email-form" method="post">
            <div asp-validation-summary="All" class="text-danger small mb-3" role="alert"></div>
            
            <!-- Email hiện tại -->
            <div class="form-floating mb-3 position-relative">
                @if (Model.IsEmailConfirmed)
                {
                    <input asp-for="Email" class="form-control bg-light text-muted border-0 shadow-none" placeholder="Email" disabled style="padding-right: 120px;" />
                    <label asp-for="Email" class="text-muted"><i class="fa-solid fa-envelope me-2"></i>Email hiện tại</label>
                    <span class="position-absolute end-0 top-50 translate-middle-y me-3 badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2">
                        <i class="fa-solid fa-circle-check me-1"></i> Đã xác thực
                    </span>
                }
                else
                {
                    <input asp-for="Email" class="form-control bg-light text-muted border-0 shadow-none" placeholder="Email" disabled style="padding-right: 140px;" />
                    <label asp-for="Email" class="text-muted"><i class="fa-solid fa-envelope me-2"></i>Email hiện tại</label>
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link position-absolute end-0 top-50 translate-middle-y me-2 text-danger fw-bold text-decoration-none small" style="z-index: 10;">
                        Xác thực ngay
                    </button>
                }
            </div>

            <!-- Email mới -->
            <div class="form-floating mb-4">
                <input asp-for="Input.NewEmail" class="form-control rounded-3 border" autocomplete="email" aria-required="true" placeholder="Nhập email mới" />
                <label asp-for="Input.NewEmail"><i class="fa-solid fa-square-plus me-2 text-danger"></i>Email mới</label>
                <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
            </div>

            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn-save-settings d-flex align-items-center gap-2">
                <i class="fa-solid fa-paper-plane"></i> Gửi yêu cầu thay đổi
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
