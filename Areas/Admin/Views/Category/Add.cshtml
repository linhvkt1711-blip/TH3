@model TH3.Models.Category

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow border-0">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Thêm danh mục mới</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Add">
                <div class="form-group mb-3">
                    <label asp-for="Name" class="fw-bold mb-1">Tên danh mục</label>
                    <input asp-for="Name" class="form-control" placeholder="VD: Điện thoại, Laptop..." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger px-4">Lưu lại</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>