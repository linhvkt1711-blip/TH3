@using TH3.Extensions
@using TH3.Models

@{
    // (1) Lấy giỏ hàng từ Session
    var cart = Context.Session.GetObjectFromJson<ShoppingCart>("Cart");

    // (2) Tính tổng số lượng sản phẩm
    int cartCount = cart?.Items.Sum(i => i.Quantity) ?? 0;
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TheAce</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            :root {
                --cps-red: #0d6efd;
            }

            body {
                background-color: #f4f4f4;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .header-main {
                background-color: var(--cps-red);
                padding: 10px 0;
                color: white;
                position: sticky;
                top: 0;
                z-index: 1000;
            }

            .search-box {
                border-radius: 10px;
                border: none;
                padding: 8px 15px;
                width: 100%;
            }

            .header-item {
                color: white;
                font-size: 13px;
                display: flex;
                align-items: center;
                gap: 8px;
                text-decoration: none;
            }

            .header-item:hover {
                color: #ffcece;
            }

            .navbar-brand {
                font-weight: bold;
                font-size: 24px;
                color: white !important;
            }

            .dropdown-menu {
                border-radius: 10px;
                margin-top: 10px;
            }

            .dropdown-item:hover {
                background-color: #f8f9fa;
                color: var(--cps-red);
            }

            footer {
                background: white;
                margin-top: 50px;
                padding: 30px 0;
                border-top: 1px solid #ddd;
            }
    </style>
</head>

<body>
    <header class="header-main shadow-sm">
        <div class="container">
            <div class="row align-items-center">

                <!-- LOGO -->
                <div class="col-lg-2 col-md-3 col-6">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-mobile-screen-button"></i> CPS
                    </a>
                </div>

                <!-- SEARCH -->
                <div class="col-lg-4 col-md-4 d-none d-md-block">
                    <form asp-controller="Home" asp-action="Index" method="get" class="position-relative">
                        <input type="text" name="searchString" class="search-box" placeholder="Bạn cần tìm gì?">
                        <button type="submit" class="btn position-absolute end-0 top-0 text-muted"
                                style="border:none; height:100%;">
                            <i class="fa fa-search"></i>
                        </button>
                    </form>
                </div>

                <!-- MENU RIGHT -->
                <ul
                    class="col-lg-6 col-md-5 col-6 d-flex align-items-center justify-content-end gap-3 list-unstyled mb-0">

                    <!-- PHONE -->
                    <li>
                        <a href="tel:0901632064" class="header-item d-none d-lg-flex">
                            <i class="fa-solid fa-phone"></i>
                            <span>Gọi mua hàng<br><b>+84</b></span>
                        </a>
                    </li>

                    <!-- CATEGORY -->
                    @await Component.InvokeAsync("CategoryMenu")

                    <!-- ADMIN -->
                    <li class="dropdown">
                        <a class="header-item dropdown-toggle" href="#" id="adminDropdown" role="button"
                               data-bs-toggle="dropdown">
                            <i class="fa-solid fa-gear"></i>
                            <span>Quản trị</span>
                        </a>

                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-controller="Category" asp-action="Index">
                                    <i class="fa-solid fa-list-check me-2"></i> Quản lý Danh mục
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Product" asp-action="Index">
                                    <i class="fa-solid fa-box-open me-2"></i> Quản lý Sản phẩm
                                </a>
                            </li>
                        </ul>
                    </li>
                    <a class="nav-link" asp-area="Admin" asp-controller="ChatManager" asp-action="Index">
                        <i class="bi bi-chat-dots"></i> Quản lý Chat
                    </a>

                    <!-- CART (3) Badge hiển thị số lượng trong giỏ -->
                    <li>
                        <a asp-controller="ShoppingCart" asp-action="Index" class="header-item position-relative">
                            <i class="fa-solid fa-cart-shopping"></i>
                            <span>Giỏ hàng</span>

                            <!-- Badges -->
                            <span class="badge bg-danger position-absolute top-0 start-100 translate-middle"
                                  style="font-size:11px; min-width: 20px;">
                                @cartCount
                            </span>
                        </a>
                    </li>

                    <!-- LOGIN / REGISTER -->
                    <div class="d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>

                </ul>
            </div>
        </div>
    </header>

    <!-- BODY -->
    <div class="container mt-3">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="footer text-muted">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5 class="text-dark fw-bold">Tổng đài hỗ trợ</h5>
                    <p class="mb-1">Gọi mua hàng:</p>
                    <p class="mb-1">Khiếu nại:</p>
                </div>

                <div class="col-md-4">
                    <h5 class="text-dark fw-bold">Thông tin</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-muted">Chính sách bảo hành</a></li>
                        <li><a href="#" class="text-muted">Giao hàng tận nơi</a></li>
                    </ul>
                </div>

                <div class="col-md-4 text-end">
                    <p>&copy; 2026 - TH3 Store - Kết nối đam mê công nghệ</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- SCRIPT -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>