@{
    ViewData["Title"] = "Quản lý Chat";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="admin-chat-container">
    <!-- SIDEBAR: Danh sách session -->
    <div class="chat-sidebar">
        <div class="sidebar-header">
            <h5><i class="bi bi-chat-dots-fill me-2"></i>Chat khách hàng</h5>
            <span class="badge bg-success" id="onlineCount">0 online</span>
        </div>
        <div class="session-list" id="sessionList">
            <div class="empty-sessions text-center text-muted p-4" id="emptyMsg">
                <i class="bi bi-inbox" style="font-size:2.5rem;opacity:.4"></i>
                <p class="mt-2 small">Chưa có cuộc trò chuyện nào</p>
            </div>
        </div>
    </div>

    <!-- MAIN: Khung chat -->
    <div class="chat-main">
        <!-- Placeholder khi chưa chọn session -->
        <div class="chat-placeholder" id="chatPlaceholder">
            <i class="bi bi-chat-square-text" style="font-size:5rem;opacity:.15"></i>
            <p class="text-muted mt-3 fw-semibold">Chọn một cuộc trò chuyện để bắt đầu</p>
            <small class="text-muted">Khách hàng sẽ xuất hiện ở bên trái khi họ nhắn tin</small>
        </div>

        <!-- Khung chat chính -->
        <div class="chat-window d-none" id="chatWindow">
            <!-- Header -->
            <div class="chat-window-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <strong id="currentSessionLabel">Khách hàng</strong>
                        <small class="text-muted d-block" id="currentSessionId"></small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success">
                        <span class="status-dot-sm"></span> Đang online
                    </span>
                </div>
            </div>

            <!-- Messages -->
            <div class="admin-messages" id="adminChatMessages">
                <div class="text-center text-muted small py-3">
                    Bắt đầu cuộc trò chuyện
                </div>
            </div>

            <!-- Input -->
            <div class="admin-input-area">
                <input type="text" id="adminInput" class="form-control"
                       placeholder="Nhập tin nhắn trả lời cho khách..." />
                <button class="btn btn-primary send-btn" id="adminSendBtn">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub?role=admin")
        .withAutomaticReconnect()
        .build();

    let currentSessionId = null;
    let sessionCount = 0;

    // ===== NHẬN SỰ KIỆN TỪ SERVER =====

    connection.on("ActiveSessions", (sessions) => {
        sessions.forEach(s => addOrUpdateSession(s, ''));
    });

    connection.on("UserMessage", (data) => {
        addOrUpdateSession(data.sessionId, data.message);
        if (currentSessionId === data.sessionId) {
            appendMsg('user', data.message, data.timestamp);
        }
    });

    connection.on("ChatHistory", (data) => {
        const container = document.getElementById('adminChatMessages');
        container.innerHTML = '';
        if (data.messages && data.messages.length > 0) {
            data.messages.forEach(m => {
                appendMsg(m.isUser ? 'user' : 'admin', m.message, m.timestamp);
            });
        } else {
            container.innerHTML = '<div class="text-center text-muted small py-3">Bắt đầu cuộc trò chuyện</div>';
        }
    });

    connection.on("ReplySent", (data) => {
        if (currentSessionId === data.sessionId) {
            appendMsg('admin', data.message, data.timestamp);
        }
    });

    // ===== HÀM QUẢN LÝ SESSION =====

    function addOrUpdateSession(sessionId, lastMsg) {
        // Ẩn thông báo trống
        document.getElementById('emptyMsg').style.display = 'none';

        let item = document.getElementById('sess_' + sessionId);
        if (!item) {
            sessionCount++;
            document.getElementById('onlineCount').textContent = sessionCount + ' online';

            item = document.createElement('div');
            item.id = 'sess_' + sessionId;
            item.className = 'session-item';
            item.innerHTML = `
                <div class="session-avatar"><i class="bi bi-person-circle"></i></div>
                <div class="session-info">
                    <div class="session-name">Khách ${sessionId.substring(5, 13)}</div>
                    <div class="session-preview" id="preview_${sessionId}">${lastMsg || 'Nhấn để xem chat'}</div>
                </div>
                <div class="session-meta">
                    <span class="new-badge d-none" id="badge_${sessionId}">Mới</span>
                </div>
            `;
            item.addEventListener('click', () => openSession(sessionId));
            document.getElementById('sessionList').appendChild(item);
        } else if (lastMsg) {
            document.getElementById('preview_' + sessionId).textContent = lastMsg;
            if (currentSessionId !== sessionId) {
                document.getElementById('badge_' + sessionId).classList.remove('d-none');
            }
        }
    }

    function openSession(sessionId) {
        currentSessionId = sessionId;

        // Update sidebar active state
        document.querySelectorAll('.session-item').forEach(i => i.classList.remove('active'));
        const item = document.getElementById('sess_' + sessionId);
        if (item) {
            item.classList.add('active');
            const badge = document.getElementById('badge_' + sessionId);
            if (badge) badge.classList.add('d-none');
        }

        // Show chat window
        document.getElementById('chatPlaceholder').classList.add('d-none');
        document.getElementById('chatWindow').classList.remove('d-none');

        // Update header
        document.getElementById('currentSessionLabel').textContent = 'Khách ' + sessionId.substring(5, 13);
        document.getElementById('currentSessionId').textContent = 'Session: ' + sessionId;

        // Load chat history + notify user
        connection.invoke("JoinSession", sessionId);
        connection.invoke("NotifyUserAdminJoined", sessionId);

        // Focus input
        document.getElementById('adminInput').focus();
    }

    // ===== HÀM HIỂN THỊ TIN NHẮN =====

    function appendMsg(type, text, time) {
        const container = document.getElementById('adminChatMessages');

        // Xóa placeholder nếu còn
        const placeholder = container.querySelector('.text-center');
        if (placeholder) placeholder.remove();

        const div = document.createElement('div');
        div.className = 'msg-row ' + (type === 'admin' ? 'msg-right' : 'msg-left');
        div.innerHTML = `
            <div class="bubble ${type === 'admin' ? 'bubble-admin' : 'bubble-user'}">
                <div class="bubble-text">${text}</div>
                <div class="bubble-time">${time || ''}</div>
            </div>
        `;
        container.appendChild(div);
        container.scrollTop = container.scrollHeight;
    }

    // ===== GỬI TIN NHẮN =====

    document.getElementById('adminSendBtn').addEventListener('click', sendReply);
    document.getElementById('adminInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') sendReply();
    });

    function sendReply() {
        const input = document.getElementById('adminInput');
        const msg = input.value.trim();
        if (!msg || !currentSessionId) return;

        connection.invoke("AdminReply", currentSessionId, msg)
            .catch(err => console.error("Lỗi gửi tin:", err));

        input.value = '';
    }

    // ===== KHỞI ĐỘNG SIGNALR =====

    connection.start()
        .then(() => console.log("Admin chat connected!"))
        .catch(err => {
            console.error("Lỗi kết nối SignalR:", err);
            document.getElementById('chatPlaceholder').innerHTML = `
                <i class="bi bi-exclamation-circle text-danger" style="font-size:3rem"></i>
                <p class="text-danger mt-3">Không thể kết nối chat. Vui lòng tải lại trang.</p>
                <button class="btn btn-outline-danger btn-sm" onclick="location.reload()">Tải lại</button>
            `;
        });
</script>
}

<style>
.admin-chat-container {
    display: flex;
    height: calc(100vh - 120px);
    border: 1px solid #dee2e6;
    border-radius: 16px;
    overflow: hidden;
    margin: 16px;
    box-shadow: 0 2px 16px rgba(0,0,0,.06);
}

/* === SIDEBAR === */
.chat-sidebar {
    width: 280px;
    min-width: 280px;
    border-right: 1px solid #dee2e6;
    display: flex;
    flex-direction: column;
    background: #f8f9fa;
}

.sidebar-header {
    padding: 16px;
    border-bottom: 1px solid #dee2e6;
    background: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.sidebar-header h5 {
    margin: 0;
    font-size: .95rem;
    font-weight: 700;
}

.session-list {
    flex: 1;
    overflow-y: auto;
}

.session-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    cursor: pointer;
    border-bottom: 1px solid #f0f0f0;
    background: white;
    transition: background .15s;
}

.session-item:hover { background: #f0f4ff; }
.session-item.active { background: #e8f0fe; border-left: 3px solid #0d6efd; }

.session-avatar {
    font-size: 1.8rem;
    color: #adb5bd;
    flex-shrink: 0;
}

.session-info { flex: 1; min-width: 0; }

.session-name {
    font-weight: 600;
    font-size: .88rem;
    color: #212529;
}

.session-preview {
    font-size: .78rem;
    color: #6c757d;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-top: 2px;
}

.new-badge {
    background: #dc3545;
    color: white;
    font-size: .65rem;
    padding: 2px 6px;
    border-radius: 10px;
    font-weight: 700;
}

/* === MAIN === */
.chat-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: white;
    min-width: 0;
}

.chat-placeholder {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.chat-window {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.chat-window-header {
    padding: 14px 20px;
    border-bottom: 1px solid #dee2e6;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: white;
    flex-shrink: 0;
}

.user-avatar {
    width: 40px;
    height: 40px;
    background: #e8f0fe;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    color: #0d6efd;
}

.status-dot-sm {
    display: inline-block;
    width: 7px;
    height: 7px;
    background: white;
    border-radius: 50%;
    margin-right: 4px;
}

/* === MESSAGES === */
.admin-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #f8f9ff;
}

.msg-row { display: flex; }
.msg-right { justify-content: flex-end; }
.msg-left { justify-content: flex-start; }

.bubble {
    max-width: 65%;
    border-radius: 18px;
    overflow: hidden;
}

.bubble-text {
    padding: 10px 14px;
    font-size: .88rem;
    line-height: 1.45;
    word-break: break-word;
}

.bubble-admin .bubble-text {
    background: #0d6efd;
    color: white;
    border-bottom-right-radius: 4px;
}

.bubble-user .bubble-text {
    background: white;
    color: #212529;
    border: 1px solid #e0e0ff;
    border-bottom-left-radius: 4px;
}

.bubble-time {
    font-size: .7rem;
    color: #bbb;
    padding: 0 14px 6px;
}

.msg-right .bubble-time { text-align: right; }

/* === INPUT === */
.admin-input-area {
    padding: 14px 16px;
    border-top: 1px solid #dee2e6;
    display: flex;
    gap: 8px;
    align-items: center;
    background: white;
    flex-shrink: 0;
}

.admin-input-area .form-control {
    border-radius: 24px;
    padding: 10px 18px;
    font-size: .88rem;
    border: 1.5px solid #dee2e6;
}

.admin-input-area .form-control:focus {
    border-color: #0d6efd;
    box-shadow: none;
}

.send-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
</style>
